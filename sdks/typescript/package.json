{
  "name": "@mars-audio/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for app-owned MARS virtual inputs",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "dist/examples", "native", "README.md"],
  "os": ["darwin"],
  "cpu": ["arm64"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "cargo build -p mars-sdk-node --release && node scripts/copy-native.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:native": "node --test test/native.test.mjs"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
