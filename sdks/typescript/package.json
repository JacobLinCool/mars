{
  "name": "@mars-audio/sdk",
  "version": "0.1.3",
  "packageManager": "pnpm@10.34.5",
  "description": "TypeScript SDK for app-owned MARS virtual inputs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JacobLinCool/mars",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/JacobLinCool/mars#sdk",
  "bugs": "https://github.com/JacobLinCool/mars/issues",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "dist/examples", "native", "README.md"],
  "os": ["darwin"],
  "cpu": ["arm64"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "cargo build -p mars-sdk-node --release && node scripts/copy-native.mjs",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "test:native": "node --test test/native.test.mjs"
  },
  "engines": { "node": ">=20" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
